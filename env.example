# Copy this file to .env and fill in your values
# GitHub token (required for private repos and label updates)
# Get from: https://github.com/settings/tokens
GH_TOKEN=

# Azure DevOps Server (on-prem) personal access token
# Used for PR URLs like https://tfs.company.local:8080/tfs/{collection}/{project}/_git/{repo}/pullrequest/{id}
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_SERVER_URL=https://tfs.company.local:8080/tfs
AZURE_DEVOPS_COLLECTION=DefaultCollection
AZURE_DEVOPS_PROJECT=

# OpenAI API key (required for complexity analysis)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Gemini / Google AI Studio API key
# GEMINI_API_KEY=

# Anthropic API key
# ANTHROPIC_API_KEY=

# Kimi (Moonshot AI) API key — OpenAI-compatible endpoint
# Get from: https://platform.moonshot.ai/
# KIMI_API_KEY=
# To override the endpoint (default https://api.moonshot.ai/v1), pass
# --api-base-url on the command line. KIMI_BASE_URL env var is ignored
# (it belongs to the Kimi Code CLI gateway).
